<div class='card-container'>
  <div class='card-title'>
    <p class='card-heading'>{{this.image.fileNameDisplay}}</p>
  </div>
  <div class='card-image'>
    <img
      class='card-image-preview'
      src={{this.image.imageData}}
      alt={{this.image.fileNameDisplay}}
    />
    <div class='overlay'>
      <button type='button' {{action 'expandImage'}}><i
          class='fas fa-expand'
        ></i></button>
    </div>
  </div>
  <div class='card-end'>
    <SelectizeInput
      @inputId={{this.selectizeInputId}}
      @maxItems={{10}}
      @initialOptions={{this.studentOptions}}
      @initialItems={{this.initialStudentItems}}
      @onItemAdd={{action 'updateSelectedIds'}}
      @onItemRemove={{action 'updateSelectedIds'}}
      @labelField='username'
      @searchField='username'
      @valueField='id'
      @model='user'
      @placeholder='Search students by username'
      @create={{action 'addStudentName'}}
      @createFilter={{this.newNameFilter}}
    />
  </div>
</div>

{{#if this.isExpanded}}
  <div class='full-image'>
    <i class='fas fa-times' {{action 'expandImage'}}></i>
    <img src={{this.image.imageData}} alt={{this.image.fileNameDisplay}} />
  </div>
{{/if}}
