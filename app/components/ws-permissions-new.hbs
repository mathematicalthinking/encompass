<div
  id='ws-permissions-new'
  {{did-update this.prefillOnUserChange @selectedUser}}
  ...attributes
>
  <p class='input-label'>
    Configure Permissions for
    <span class='username'>{{@selectedUser.username}}</span>
    <span
      class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
      data-tooltip='Select which permissions this user should have for this new workspace'
    >
      <i class='fas fa-info-circle info-icon'></i>
    </span>
  </p>

  <div class='submission-permissions'>
    <Ui::RadioGroup
      @options={{this.submissionItems}}
      @selectedValue={{this.submissions}}
      @updateValue={{this.updateSubmissions}}
    />
    {{#if this.closedCustomView}}
      <button
        type='button'
        class='show-viewer'
        {{on 'click' this.showViewer}}
      >Show Viewer</button>
    {{/if}}
    {{#if this.showCustomSubmissions}}
      <CustomSubmissionViewerList
        @submissions={{@submissionsPool}}
        @selectedSubmissionIds={{this.customSubmissionIds}}
        @onSelect={{this.updateCustomSubs}}
        @onSelectAll={{this.selectAllSubmissions}}
        @onUnselectAll={{this.deselectAllSubmissions}}
        @onDone={{this.closeCustomSelect}}
      />
    {{/if}}
  </div>

  <div class='global-permissions'>
    <Ui::RadioGroup
      @options={{this.globalItems}}
      @selectedValue={{this.global}}
      @updateValue={{this.updateGlobal}}
    />
    {{#if this.showCustom}}
      <div class='custom-global-permissions'>
        <p class='input-label'>
          Configure Custom Permissions
          <span
            class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
            data-tooltip='Decide user permissions for each aspect of this workspace'
          >
            <i class='fas fa-info-circle info-icon'></i>
          </span>
        </p>
        <Ui::RadioGroup
          @options={{this.selectionItems}}
          @selectedValue={{this.selections}}
          @updateValue={{this.updateSelections}}
        />
        <Ui::RadioGroup
          @options={{this.commentItems}}
          @selectedValue={{this.comments}}
          @updateValue={{this.updateComments}}
        />
        <Ui::RadioGroup
          @options={{this.folderItems}}
          @selectedValue={{this.folders}}
          @updateValue={{this.updateFolders}}
        />
        <Ui::RadioGroup
          @options={{this.feedbackItems}}
          @selectedValue={{this.feedback}}
          @updateValue={{this.updateFeedback}}
        />
      </div>
    {{/if}}
  </div>

  {{#if this.saveError}}
    <Ui::ErrorBox
      @error='Sorry, something went wrong. Please try again.'
      @resetError={{this.resetSaveError}}
      @showDismiss={{true}}
    />
  {{/if}}

  <button
    class='primary-button cancel-button'
    type='button'
    {{on 'click' @stopEditing}}
  >Cancel</button>
  <button
    class='primary-button'
    type='button'
    {{on 'click' this.savePermissions}}
  >Save Permissions</button>
</div>
