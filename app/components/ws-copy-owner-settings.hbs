<div id='ws-copy-owner-settings' ...attributes>
  <div class='ws-copy-input name'>
    <p class='input-label'>
      Workspace Name
      <span
        class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
        data-tooltip='Provide the new name for your workspace'
      >
        <i class='fas fa-info-circle info-icon'></i>
      </span>
    </p>
    <div class='single-text-input-container'>
      <input
        class='single-text-input'
        id='ws-copy-name'
        type='text'
        value={{this.selectedName}}
        placeholder='Provide a name for your workspace'
        {{on 'input' this.updateName}}
      />
    </div>
  </div>

  {{#each this.nameErrors as |error|}}
    <Ui::ErrorBox
      @error={{error}}
      @showDismiss={{true}}
      @resetError={{this.resetNameErrors}}
    />
  {{/each}}

  <div class='ws-copy-input owner'>
    <p class='input-label'>
      Owner
      <span
        class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
        data-tooltip='Select or type the username of the desired owner for this workspace'
      >
        <i class='fas fa-info-circle info-icon'></i>
      </span>
    </p>
    <SelectizeInput
      @inputId='owner-select'
      @initialOptions={{this.initialOwnerOptions}}
      @initialItems={{this.initialOwnerItem}}
      @maxItems={{1}}
      @onItemAdd={{this.setOwner}}
      @onItemRemove={{this.setOwner}}
      @labelField='username'
      @valueField='id'
      @searchField='username'
      @model='user'
      @queryParamsKey='usernameSearch'
      @isAsync={{true}}
      @placeholder='Search users to choose as owner'
    />
  </div>

  {{#each this.ownerErrors as |error|}}
    <Ui::ErrorBox
      @error={{error}}
      @showDismiss={{true}}
      @resetError={{this.resetOwnerErrors}}
    />
  {{/each}}

  <div class='ws-copy-input mode'>
    <p class='input-label'>
      Privacy Setting
      <span
        class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
        data-tooltip='Decide who can see this workspace, hover over the question icons for more info'
      >
        <i class='fas fa-info-circle info-icon'></i>
      </span>
    </p>
    <Ui::RadioGroup
      @options={{@modeInputs}}
      @selectedValue={{this.selectedMode}}
      @updateValue={{this.updateSelectedMode}}
    />
  </div>

  {{#each this.modeErrors as |error|}}
    <Ui::ErrorBox
      @error={{error}}
      @showDismiss={{true}}
      @resetError={{this.resetModeErrors}}
    />
  {{/each}}

  <div class='ws-copy-input folderset'>
    <p class='input-label'>
      Folder Set
      <span
        class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
        data-tooltip='You can save the folder structure from this workspace as a reusable fodler set'
      >
        <i class='fas fa-info-circle info-icon'></i>
      </span>
    </p>

    {{#if @isCopyingFolders}}

      <p class='sub-input-label'>Do you want to save this folder structure as a
        folder set for future use?</p>
      <ul class='radio-list'>
        <li class='radio-group-item'>
          <label>
            <input
              type='radio'
              name='doCreateFolderSet'
              checked={{is-equal this.doCreateFolderSet true}}
              {{on 'click' (fn this.toggleCreateFolderset true)}}
            />
            <span>Yes</span>
          </label>
        </li>
        <li class='radio-group-item'>
          <label>
            <input
              type='radio'
              name='doCreateFolderSet'
              checked={{is-equal this.doCreateFolderSet false}}
              {{on 'click' (fn this.toggleCreateFolderset false)}}
            />
            <span>No</span>
          </label>
        </li>
      </ul>

      {{#if this.doCreateFolderSet}}
        <NewFoldersetForm
          @nameErrors={{this.folderSetNameErrors}}
          @privacyErrors={{this.folderSetPrivacySettingErrors}}
          @name={{this.folderSetName}}
          @privacySetting={{this.folderSetPrivacy}}
          @onNameChange={{this.updateFolderSetName}}
          @onPrivacyChange={{this.updateFolderSetPrivacy}}
        />
        {{#if this.duplicateFolderSetName}}
          <Ui::ErrorBox
            @error='There already exists a public Folder Set with that name. Please choose a different name.'
            @showDismiss={{true}}
            @resetError={{this.resetDuplicateFolderSetName}}
          />
        {{/if}}
      {{/if}}

    {{else}}
      <p class='sub-input-label'>Your workspace will have 0 folders. Select a
        pre-existing folder set below or continue on without any folders</p>
      <SelectizeInput
        @inputId='folderset-select'
        @maxItems={{1}}
        @initialOptions={{this.initialFolderSetOptions}}
        @initialItems={{this.initialFolderSetItem}}
        @onItemAdd={{this.setFolderSet}}
        @onItemRemove={{this.setFolderSet}}
        @labelField='name'
        @valueField='id'
        @searchField='name'
        @model='folder-set'
        @placeholder='Select a Folder Set'
      />
    {{/if}}
  </div>

  <div class='nav-btn-container'>
    <button
      class='primary-button cancel-button'
      type='button'
      {{on 'click' this.back}}
    >Back</button>
    <button
      class='primary-button'
      type='button'
      {{on 'click' this.next}}
    >Next</button>
  </div>
</div>
