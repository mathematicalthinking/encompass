<div id='workspace-new-copy' ...attributes>
  <div class='flex-container-full'>
    <div
      class='flex-item-full filter-options
        {{if this.isFilterCollapsed "collapse"}}'
      id='filter-list-side'
    >
      <div class='filter-items'>
        <h2>Summary</h2>
        <ul class='primary-filter-list'>
          {{#each this.detailsItems as |item|}}
            <DetailsListItem
              @label={{item.label}}
              @displayValue={{item.displayValue}}
              @emptyValue={{item.emptyValue}}
              @propName={{item.propName}}
              @children={{item.children}}
              @isArray={{item.isArray}}
              @editValue={{this.goToStep}}
              @associatedStep={{item.associatedStep}}
              @currentStep={{this.currentStep.value}}
            />
          {{/each}}
        </ul>
      </div>
    </div>
    <div class='flex-item-full list-view' {{on 'click' this.collapseFilter}}>
      <div class='results-list'>
        <div class='header'>
          <h1>Copy Workspace</h1>
        </div>

        <div class='step-display'>
          <div class='container'>
            <ul class='progressbar'>
              <li class='step-1 active-step'>
                <span>Select Workspace</span>
              </li>
              <li
                class='step-2
                  {{if (greater-equal this.currentStep.value 2) "active-step"}}'
              >
                <span>Copy Configuration</span>
              </li>
              <li
                class='step-3
                  {{if (greater-equal this.currentStep.value 3) "active-step"}}'
              >
                <span>Workspace Info</span>
              </li>
              <li
                class='step-4
                  {{if (greater-equal this.currentStep.value 4) "active-step"}}'
              >
                <span>Collaborators</span>
              </li>
              <li
                class='step-5
                  {{if (greater-equal this.currentStep.value 5) "active-step"}}'
              >
                <span>Review</span>
              </li>
            </ul>
          </div>
        </div>

        <div class='step-content'>
          {{#if this.showSelectWorkspace}}
            <WsCopyWorkspace
              @showLoadingSubmissions={{this.showLoadingSubmissions}}
              @loadSubmissionErrors={{this.loadSubmissionErrors}}
              @selectedWorkspace={{this.selectedWorkspace}}
              @fromWorkspaceList={{this.fromWorkspaceList}}
              @onSelectWorkspace={{this.setSelectedWorkspace}}
              @onProceed={{this.setOriginalWorkspace}}
            />
          {{/if}}

          {{#if this.showSelectConfig}}
            <WsCopyConfig
              @workspace={{this.workspaceToCopy}}
              @submissionThreads={{this.submissionThreads}}
              @newWsConfig={{this.newWsConfig}}
              @copyConfig={{this.copyConfig}}
              @onProceed={{this.setConfig}}
              @onBack={{this.changeStep}}
            />
          {{/if}}

          {{#if this.showOwnerSettings}}
            <WsCopyOwnerSettings
              @newWsOwner={{this.newWsOwner}}
              @newWsMode={{this.newWsMode}}
              @newWsName={{this.newWsName}}
              @newFolderSetOptions={{this.newFolderSetOptions}}
              @workspace={{this.selectedWorkspace}}
              @modeInputs={{this.modeInputs}}
              @onProceed={{this.setOwnerSettings}}
              @folderSets={{@model.folderSets}}
              @isCopyingFolders={{this.isCopyingFolders}}
              @onBack={{this.changeStep}}
              @existingFolderSet={{this.existingFolderSet}}
            />
          {{/if}}

          {{#if this.showPermissions}}
            <WsCopyPermissions
              @submissionsPool={{this.submissionsPool}}
              @workspace={{this.workspaceToCopy}}
              @newWsPermissions={{this.newWsPermissions}}
              @newWsOwner={{this.newWsOwner}}
              @onProceed={{this.setPermissions}}
              @onBack={{this.changeStep}}
            />
          {{/if}}

          {{#if this.showReview}}
            <WsCopyReview
              @showLoadingMessage={{this.showRequestLoading}}
              @mode={{this.newWsMode}}
              @owner={{this.newWsOwner}}
              @name={{this.newWsName}}
              @workspace={{this.workspaceToCopy}}
              @onProceed={{this.createCopyRequest}}
              @onBack={{this.changeStep}}
              @recordCounts={{this.recordCounts}}
            />
          {{/if}}
        </div>

        {{#if this.customConfigError}}
          <Ui::ErrorBox
            @error='Sorry, something went wrong processing your custom configuration.'
            @showDismiss={{true}}
            @resetError={{this.resetCustomConfigError}}
          />
        {{/if}}
        {{#if this.copyWorkspaceError}}
          <Ui::ErrorBox
            @error={{this.copyWorkspaceError}}
            @showDismiss={{true}}
            @resetError={{this.resetCopyWorkspaceError}}
          />
        {{/if}}

        {{#each this.serverErrors as |error|}}
          <Ui::ErrorBox @error={{error}} @showDismiss={{true}} />
        {{/each}}
      </div>
    </div>
  </div>

  <div class='toggle-filter-menu'>
    <button type='button' {{on 'click' this.toggleMenu}}><i
        id='arrow-icon'
        class='fas fa-chevron-right
          {{unless this.isFilterCollapsed "fa-rotate-180"}}'
      ></i></button>
  </div>
</div>
