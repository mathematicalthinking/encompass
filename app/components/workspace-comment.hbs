<li class={{this.commentClasses}}>
<div class='comment-flex-item text'>
  <p>
    {{#if this.isForCurrentWorkspace}}
      <LinkTo
        @route='workspace.submissions.submission.selections.selection'
        @models={{array
          this.commentSelection.submission
          this.commentSelection
        }}
        class='comment comment-text'
      >
        {{this.commentText}}
      </LinkTo>
    {{else}}
      <a
        class='newWindow comment-text'
        target='_blank'
        href='{{this.commentSelection.link}}'
        rel='noopener noreferrer'
      >{{this.commentText}}</a>
    {{/if}}
  </p>
  <p class='meta'>
    by
    <span class='creator'>
      {{this.commentCreator.username}}
    </span>
    in
    <span class='workspace'>
      {{this.commentWorkspace.name}}
    </span>
  </p>
</div>
<div class='comment-flex-item actions'>
  {{#if this.canDelete}}
    <span {{on "click" this.deleteComment}} class='delete_button'><i
        class='fas fa-minus-circle'
      ></i></span>
  {{/if}}
  {{#if this.permittedToComment}}
    <a {{on "click" this.reuseComment}} title='reuse this comment'>
      {{#if this.childrenLength}}
        {{this.childrenLength}}
      {{else}}
        <i class='fas fa-plus'></i>
      {{/if}}
    </a>
  {{/if}}
</div>

<div class='clear'></div>
</li>