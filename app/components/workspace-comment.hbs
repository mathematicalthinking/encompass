<li class={{this.commentClasses}}>
<div class='comment-flex-item text'>
  <p>
    {{#if this.isForCurrentWorkspace}}
      {{#if this.commentSelectionModels}}
        <LinkTo
          @route='workspace.submissions.submission.selections.selection'
          @models={{this.commentSelectionModels}}
          class='comment comment-text'
        >
          {{this.commentText}}
        </LinkTo>
      {{else}}
        <span class='comment comment-text'>{{this.commentText}}</span>
      {{/if}}
    {{else}}
      {{#if this.commentSelectionModelsWithWorkspace.length}}
        <LinkTo
          @route='workspace.submissions.submission.selections.selection'
          @models={{this.commentSelectionModelsWithWorkspace}}
          class='comment-text newWindow'
          target='_blank'
        >
          {{this.commentText}}
        </LinkTo>
      {{else}}
        <span class='comment comment-text'>{{this.commentText}}</span>
      {{/if}}
    {{/if}}
  </p>
  <p class='meta'>
    by
    <span class='creator'>
      {{this.commentCreator.username}}
    </span>
    in
    <span class='workspace'>
      {{this.commentWorkspace.name}}
    </span>
  </p>
</div>
<div class='comment-flex-item actions'>
  {{#if this.canDelete}}
    <span {{on "click" this.deleteComment}} class='delete_button'><i
        class='fas fa-minus-circle'
      ></i></span>
  {{/if}}
  {{#if this.permittedToComment}}
    <button
      type='button'
      class='reuse_button'
      {{on "click" this.reuseComment}}
      title='reuse this comment'
    >
      {{#if this.childrenLength}}
        {{this.childrenLength}}
      {{else}}
        <i class='fas fa-plus'></i>
      {{/if}}
    </button>
  {{/if}}
</div>

<div class='clear'></div>
</li>