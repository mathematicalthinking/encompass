          {{on "click" (fn this.bringDownVariant 'F')}}
        >Copy to Editor</button>
      </div>
    </div>
  </div>
  
  {{!-- A/B TEST BOUNDARY MARKERS --}}
  <div class="ab-test-boundary">
    <div class="ab-test-end-marker">▶▶▶ END A/B TEST ◀◀◀</div>
  </div>
</div>
