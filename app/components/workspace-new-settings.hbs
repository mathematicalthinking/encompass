<div id='workspace-new-settings'>
  <h1>Create New Workspace</h1>
  <button class='back-button' type='button' {{on 'click' this.back}}>
    <i class='fas fa-arrow-left'></i>
    Submission Viewer</button>
  <div class='create-ws-content'>
    <div class='ws-new name'>
      <p class='input-label'>
        Workspace Name
        <span
          class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
          data-tooltip='Provide an easily identifiable name for this workspace'
        >
          <i class='fas fa-info-circle info-icon'></i>
        </span>
      </p>
      <div class='single-text-input-container'>
        <Input
          id='ws-new-name'
          class='single-text-input'
          @type='text'
          @value={{this.workspaceName}}
          placeholder='Provide a name for your workspace'
        />
      </div>
      {{#each this.workspaceNameErrors as |error|}}
        <Ui::ErrorBox
          @error={{error}}
          @showDismiss={{true}}
          @resetError={{fn this.resetError 'workspaceNameErrors'}}
        />
      {{/each}}
    </div>

    <div class='ws-new owner'>
      <p class='input-label'>
        Workspace Owner
        <span
          class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
          data-tooltip='The owner of the workspace has the ability to edit every aspect of this workspace. You can make it yourself'
        >
          <i class='fas fa-info-circle info-icon'></i>
        </span>
      </p>
      <SelectizeInput
        @inputId='owner-select'
        @initialOptions={{this.ownerOptions}}
        @initialItems={{this.initialOwner}}
        @maxItems={{1}}
        @onItemAdd={{this.updateSelectizeSingle}}
        @onItemRemove={{this.updateSelectizeSingle}}
        @labelField='username'
        @valueField='id'
        @searchField='username'
        @model='user'
        @propToUpdate='selectedOwner'
        @placeholder='Search by username to choose as owner'
        @isDisabled={{is-equal this.currentUser.user.accountType 'T'}}
      />
      {{#each this.ownerErrors as |error|}}
        <Ui::ErrorBox
          @error={{error}}
          @showDismiss={{true}}
          @resetError={{fn this.resetError 'ownerErrors'}}
        />
      {{/each}}
    </div>

    <div class='ws-new mode'>
      <p class='input-label'>
        Privacy Setting
        <span
          class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
          data-tooltip='Decide who can see this workspace, hover over the question mark icons for more info'
        >
          <i class='fas fa-info-circle info-icon'></i>
        </span>
      </p>
      <Ui::RadioGroup
        @options={{this.modeInputs}}
        @selectedValue={{this.selectedMode}}
        @updateValue={{this.updateSelectedMode}}
      />
      {{#each this.privacySettingErrors as |error|}}
        <Ui::ErrorBox
          @error={{error}}
          @showDismiss={{true}}
          @resetError={{fn this.resetError 'privacySettingErrors'}}
        />
      {{/each}}
    </div>

    <div class='ws-new folderset'>
      <p class='input-label'>
        Folder Set
        <span
          class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
          data-tooltip='You can choose one of your saved folder sets or a provided set'
        >
          <i class='fas fa-info-circle info-icon'></i>
        </span>
      </p>
      <SelectizeInput
        @inputId='folderset-select'
        @initialOptions={{this.folderSetOptions}}
        @maxItems={{1}}
        @onItemAdd={{this.updateSelectizeSingle}}
        @onItemRemove={{this.updateSelectizeSingle}}
        @labelField='name'
        @valueField='id'
        @searchField='name'
        @model='folder-set'
        @propToUpdate='selectedFolderSet'
        @placeholder='Select a Folder Set'
      />
      {{#each this.folderSetErrors as |error|}}
        <Ui::ErrorBox
          @error={{error}}
          @showDismiss={{true}}
          @resetError={{fn this.resetError 'folderSetErrors'}}
        />
      {{/each}}
    </div>

    <div class='ws-new submission-settings'>
      <p class='input-label'>
        Submission Settings
        <span
          class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
          data-tooltip='Choose whether to include all revisions or just submissions of record'
        >
          <i class='fas fa-info-circle info-icon'></i>
        </span>
      </p>
      <Ui::RadioGroup
        @options={{this.submissionSettingsInputs}}
        @selectedValue={{this.selectedSubmissionSettings}}
        @updateValue={{this.updateSelectedSubmissionSettings}}
      />
    </div>
    <WsNewSettingsPermissions
      @permissions={{this.workspacePermissions}}
      @users={{@users}}
      @isEditing={{this.isEditingPermissions}}
      @selectedCollaborator={{this.unsavedCollaborator}}
      @initialCollabOptions={{this.initialCollabOptions}}
      @selectedCollaborators={{this.selectedCollaborators}}
      @onSavePermission={{this.savePermission}}
      @onRemovePermission={{this.removePermission}}
    />

    <div class='create-ws-error'>
      {{#if @createWorkspaceError}}
        <Ui::ErrorBox
          @error={{@createWorkspaceError}}
          @showDismiss={{true}}
          @resetError={{fn this.resetError 'createWorkspaceError'}}
        />
      {{/if}}
    </div>

    <button
      class='primary-button create-ws'
      type='button'
      {{on 'click' this.handleSettings}}
    >Create Workspace</button>
  </div>
</div>
