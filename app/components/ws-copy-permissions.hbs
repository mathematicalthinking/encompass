<div id='ws-copy-permissions' ...attributes>
  <p class='input-label'>
    Collaborators
    <span
      class='info-text-tip simptip-position-right simptip-multiline simptip-smooth'
      data-tooltip='Collaborators are users that can see or participate in your workspace. You can customize their permissions settings in detail after you add them.'
    >
      <i class='fas fa-info-circle info-icon'></i>
    </span>
  </p>

  <p class='sub-input-label'>Select a user to configure their permissions for
    this workspace.</p>
  <SelectizeInput
    @inputId='collab-select'
    @maxItems={{1}}
    @onItemAdd={{this.setCollaborator}}
    @onItemRemove={{this.setCollaborator}}
    @initialOptions={{this.initialCollabOptions}}
    @selectedItemsHash={{this.selectedCollaborators}}
    @labelField='username'
    @valueField='id'
    @searchField='username'
    @model='user'
    @queryParamsKey='usernameSearch'
    @isAsync={{true}}
    @placeholder='Search for collaborators to add'
    @preload='focus'
  />

  {{#if this.permissions}}
    <div class='collaborator-list'>
      <p class='input-label'>Added Collaborators</p>
      <ul>
        {{#each this.permissions as |permission|}}
          <li>{{permission.user.username}}
            <button
              type='button'
              class='icon-button'
              title='Modify'
              aria-label='Modify collaborator'
              {{on 'click' (fn this.editCollab permission)}}
            ><i class='far fa-edit' aria-hidden='true'></i></button>
            <button
              type='button'
              class='icon-button'
              title='Remove'
              aria-label='Remove collaborator'
              {{on 'click' (fn this.removeCollab permission)}}
            ><i class='fas fa-minus-circle' aria-hidden='true'></i></button>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  {{#if this.selectedCollaborator}}
    <WsPermissionsNew
      @submissionsPool={{@submissionsPool}}
      @workspace={{@workspace}}
      @onSave={{this.savePermissions}}
      @permissions={{this.permissions}}
      @selectedUser={{this.selectedCollaborator}}
      @stopEditing={{this.stopEditing}}
      @onSubViewChange={{this.setSubViewState}}
    />
  {{/if}}

  {{#unless this.doHideNavButtons}}
    <div class='nav-btn-container'>
      <button
        class='primary-button cancel-button'
        type='button'
        {{on 'click' this.back}}
      >Back</button>
      <button
        class='primary-button'
        type='button'
        {{on 'click' this.next}}
      >Next</button>
    </div>
  {{/unless}}
</div>
