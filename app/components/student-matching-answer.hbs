<div class='card-container student-matching-answer'>
  <div class='card-title'>
    <p class='card-heading'>{{this.image.fileNameDisplay}}</p>
  </div>
  <div class='card-image'>
    <img
      class='card-image-preview'
      src={{this.image.imageData}}
      alt={{this.image.fileNameDisplay}}
    />
    <div class='overlay'>
      <button type='button' {{on 'click' this.expandImage}}><i
          class='fas fa-expand'
        ></i></button>
    </div>
  </div>
  <div class='card-end'>
    <SelectizeInput
      @inputId={{this.selectizeInputId}}
      @maxItems={{10}}
      @initialOptions={{this.studentOptions}}
      @initialItems={{this.initialStudentItems}}
      @onItemAdd={{this.updateSelectedIds}}
      @onItemRemove={{this.updateSelectedIds}}
      @labelField='username'
      @searchField='username'
      @valueField='id'
      @model='user'
      @placeholder={{this.selectizePlaceholder}}
      @closeAfterSelect={{true}}
      @preserveCurrentItemsOnOptionsUpdate={{true}}
      @create={{if this.allowCustomNameEntry this.addStudentName null}}
      @createFilter={{if this.allowCustomNameEntry @newNameFilter null}}
    />
  </div>
</div>

{{#if this.isExpanded}}
  <div class='full-image'>
    <button type='button' {{on 'click' this.expandImage}}>
      <i class='fas fa-times'></i>
    </button>
    <img src={{this.image.imageData}} alt={{this.image.fileNameDisplay}} />
  </div>
{{/if}}
