<div id='workspace-info-collaborators-new'>
  <div class='collab-container'>
    <div class='collab-name'>
      <SelectizeInput
        @inputId='collab-select'
        @maxItems={{1}}
        @initialOptions={{@initialCollabOptions}}
        @selectedItemsHash={{@selectedCollaborators}}
        @onItemAdd={{this.setCollab}}
        @onItemRemove={{this.setCollab}}
        @labelField='username'
        @valueField='id'
        @searchField='username'
        @model='user'
        @queryParamsKey='usernameSearch'
        @isAsync={{true}}
        @placeholder='Search by username'
        @preload='focus'
      />
    </div>
    <div class='collab-settings global'>
      <Ui::RadioGroup
        @options={{@globalItems}}
        @selectedValue={{this.globalPermissionValue}}
        @updateValue={{this.updateGlobalPermissionValue}}
      />
    </div>

    <div class='collab-settings'>
      {{#if this.showCustom}}
        <div class='card-row'>
          <div class='row-label'>
            Submissions
          </div>
          <div class='row-value'>
            <Ui::MySelect
              @cannotBeNull={{true}}
              @selectedValue={{this.submissions}}
              @content={{this.submissionPermissions}}
              @action={{this.setSubmissions}}
            />
            {{#if (is-equal this.submissions.value 'custom')}}
              <span class='submission-count'>{{@customSubmissionIds.length}}
                submissions selected</span>
              <span class='viewer-toggle' {{on 'click' this.toggleSubmissionView}}>
                {{if @isShowingCustomViewer 'Hide' 'Show'}}
                Submission Viewer</span>
            {{/if}}
          </div>
        </div>
        <div class='card-row'>
          <div class='row-label'>
            Selections
          </div>
          <div class='row-value'>
            <Ui::MySelect
              @cannotBeNull={{true}}
              @selectedValue={{this.selections}}
              @content={{this.mainPermissions}}
              @action={{this.setSelections}}
            />
          </div>
        </div>
        <div class='card-row'>
          <div class='row-label'>
            Comments
          </div>
          <div class='row-value'>
            <Ui::MySelect
              @cannotBeNull={{true}}
              @selectedValue={{this.comments}}
              @content={{this.mainPermissions}}
              @action={{this.setComments}}
            />
          </div>
        </div>
        <div class='card-row'>
          <div class='row-label'>
            Folders
          </div>
          <div class='row-value'>
            <Ui::MySelect
              @cannotBeNull={{true}}
              @selectedValue={{this.folders}}
              @content={{this.mainPermissions}}
              @action={{this.setFolders}}
            />
          </div>
        </div>
        <div class='card-row'>
          <div class='row-label'>
            Feedback
          </div>
          <div class='row-value'>
            <Ui::MySelect
              @cannotBeNull={{true}}
              @selectedValue={{this.feedback}}
              @content={{this.feedbackPermissions}}
              @action={{this.setFeedback}}
            />
          </div>
        </div>
      {{/if}}
      {{#if this.missingUserError}}
        <div class='card-row'>
          <Ui::ErrorBox
            @error='Please select a user'
            @resetError={{this.clearMissingUserError}}
            @showDismiss={{true}}
          />
        </div>
      {{/if}}
      {{#if this.existingUserError}}
        <div class='card-row'>
          <Ui::ErrorBox
            @error='Collaborator already exists. Edit permissions below'
            @resetError={{this.clearExistingUserError}}
            @showDismiss={{true}}
          />
        </div>
      {{/if}}
      <div class='button-row'>
        <button
          class='primary-button cancel-button'
          type='button'
          {{on 'click' this.cancelCreateCollab}}
        >Cancel</button>
        <button
          class='primary-button'
          type='button'
          {{on 'click' this.saveCollab}}
        >Save</button>
      </div>
    </div>
  </div>
</div>