<div id='section-info' class='section-info'>
  <header class='info-header'>
    <h2>Class Details</h2>
    <div class='clear'></div>
  </header>

  {{#each this.dataLoadErrors as |error|}}
    <p class='error-message'>{{error}}</p>
  {{/each}}
  <form data-test='section-info-form' id='sectioninfo' {{on 'submit' this.handleFormSubmit}}>
    <fieldset>
      <div class='section-info-detail name'>
        <label for='name'>Class Name
          {{#unless this.cantEdit}}
            {{#if this.isEditingName}}
              <i
                title='Done'
                {{on 'click' this.updateSectionName}}
                class='fa fa-check'
              ></i>
            {{else}}
              <i
                title='Edit'
                {{on 'click' this.startEditingName}}
                class='far fa-edit'
              ></i>
            {{/if}}
          {{/unless}}
        </label>

        <Ui::FormField
          data-test='section-name-display'
          @id='name'
          @name='name'
          @type='text'
          @isEditing={{this.isEditingName}}
          @value={{if this.isEditingName this.editedSectionName @section.name}}
          @className='section-info'
          @onChange={{this.handleSectionNameInput}}
          @onKeydown={{this.handleSectionNameKeydown}}
        />
      </div>
      <div class='section-info-detail assignments'>
        <label for='assignments'>Assignments
          {{#unless this.cantEdit}}
            {{#if this.isEditingAssignments}}
              <i
                title='Done'
                {{on 'click' (fn this.setIsEditingAssignments false)}}
                class='fa fa-check'
              ></i>
            {{else}}
              <i
                title='Edit'
                {{on 'click' (fn this.setIsEditingAssignments true)}}
                class='far fa-edit'
              ></i>
            {{/if}}
          {{/unless}}
        </label>
        <ul class='listing'>
          {{#if @section.assignments}}
            {{#each @section.assignments as |assignment|}}
              <li><LinkTo
                  @route='assignments.assignment'
                  @model={{assignment.id}}
                >{{assignment.name}}</LinkTo></li>
            {{/each}}
          {{else}}
            <li>No Assignments yet</li>
          {{/if}}
        </ul>
        {{#unless this.cantEdit}}{{/unless}}
      </div>
      {{#if this.isEditingAssignments}}
        <div class='btn-container'>
          <button
            class='action_button'
            type='button'
            {{on 'click' this.updateShowAssignment}}
          >New Assignment</button>
        </div>
      {{/if}}
      <div class='section-info-detail teachers'>
        <label for='teachers'>Teachers
          {{#unless this.cantEdit}}
            {{#if this.isEditingTeachers}}
              <i
                title='Done'
                {{on 'click' (fn this.setIsEditingTeachers false)}}
                class='fa fa-check'
              ></i>
            {{else}}
              <i
                title='Edit'
                {{on 'click' (fn this.setIsEditingTeachers true)}}
                class='far fa-edit'
              ></i>
            {{/if}}
          {{/unless}}
        </label>
        <ul class='listing'>
          {{#each @section.teachers as |teacher|}}
            <li>
              {{#if this.currentUser.isStudent}}
                {{teacher.username}}
              {{else}}
                <LinkTo @route='users.user' @model={{teacher.id}}>
                  {{teacher.username}}
                </LinkTo>
              {{/if}}

              {{#unless this.cantEdit}}
                {{#if this.isEditingTeachers}}
                  <button
                    class='trash-button'
                    type='button'
                    {{on 'click' (fn this.removeTeacher teacher)}}
                  >
                    <i
                      title='remove'
                      class='far fa-times-circle'
                      aria-hidden='true'
                    ></i>
                  </button>
                {{/if}}
              {{/unless}}
            </li>
          {{/each}}
        </ul>
        {{#if this.removeTeacherError}}
          <p class='error-message'>You must have at least one teacher</p>
        {{/if}}

      </div>
      {{#unless this.cantEdit}}
        {{#if this.isEditingTeachers}}
          <div class='update-teachers'>
            <label>Add Teacher<i
                title="Start typing a teacher's username to see suggestions"
                class='fas fa-info-circle fa-sm'
              ></i></label>
            <SelectizeInput
              @inputId='select-add-teacher'
              @maxItems={{1}}
              @initialOptions={{this.initialTeacherOptions}}
              @onItemAdd={{this.addTeacher}}
              @model='user'
              @isAsync={{true}}
              @labelField='username'
              @searchField='username'
              @valueField='id'
              @customQueryParams={{this.addTeacherQueryParams}}
              @queryParamsKey='usernameSearch'
            />

            {{#each this.updateTeacherErrors as |error|}}
              <p class='error-message'>{{error}}</p>
            {{/each}}
          </div>
        {{/if}}
      {{/unless}}
      <div class='section-info-detail students'>
        <label for='students'>Students
          {{#unless this.cantEdit}}
            {{#if this.isEditingStudents}}
              <i
                title='Done'
                {{on 'click' (fn this.setIsEditingStudents false)}}
                class='fa fa-check'
              ></i>
            {{else}}
              <i
                data-test='edit-students'
                title='Edit'
                {{on 'click' (fn this.setIsEditingStudents true)}}
                class='far fa-edit'
              ></i>
            {{/if}}
          {{/unless}}
        </label>
        <ul class='listing'>
          {{#each @section.students as |student|}}
            <li>
              {{#if this.currentUser.isStudent}}
                {{student.username}}
              {{else}}
                <LinkTo @route='users.user' @model={{student.id}}>
                  {{student.username}}
                </LinkTo>
              {{/if}}
              {{#unless this.cantEdit}}
                <LinkTo @route='users.user' @model={{student.id}} />
                {{#if this.isEditingStudents}}
                  <button
                    class='trash-button'
                    type='button'
                    {{on 'click' (fn this.removeStudent student)}}
                  >
                    <i class='far fa-times-circle' aria-hidden='true'></i>
                  </button>
                {{/if}}
              {{/unless}}
            </li>
          {{else}}
            <p class='info'>No students yet.</p>
          {{/each}}
        </ul>

      </div>
      <div class='update-students'>
        {{#if this.isEditingStudents}}
          <AddCreateStudent
            @section={{this.currentSection}}
            @students={{this.studentList}}
            @sectionPassword={{@section.sectionPassword}}
          />
        {{/if}}
        {{#each this.updateStudentErrors as |error|}}
          <p class='error-message'>{{error}}</p>
        {{/each}}
      </div>
      <div class='section-info-detail groups'>
        <label for='groups'>Groups:
          {{#unless this.cantEdit}}
            {{#if this.addGroup}}
              <i
                title='Done'
                {{on 'click' this.toggleAddGroup}}
                class='fa fa-check'
              ></i>
            {{else}}
              <i
                title='Edit'
                {{on 'click' this.toggleAddGroup}}
                class='far fa-edit'
              ></i>
            {{/if}}
          {{/unless}}
        </label>
        {{#if this.addGroup}}
          <div class='update-students'>
            <Ui::FormField
              @name='new-group-name'
              @type='text'
              @isEditing={{true}}
              @value={{this.newGroupName}}
              @placeholder='New Group Name'
              @className='new-group-name'
              @onChange={{this.handleNewGroupNameInput}}
            />
            <ul class='listing group-options'>
              {{#each this.studentList as |student|}}
                <li>
                  <Ui::FormField
                    @id={{concat 'group-student-' student.id}}
                    @name={{concat 'group-student-' student.id}}
                    @type='checkbox'
                    @isEditing={{true}}
                    @label={{student.username}}
                    @value={{is-in this.newGroupStudents student}}
                    @onChange={{fn this.placeStudent student}}
                  />
                  <i
                    class={{if
                      (is-in this.groupedStudents student.id)
                      'fa fa-check'
                    }}
                  ></i>
                </li>
              {{/each}}
            </ul>
            <button
              class='primary-button save-group'
              type='button'
              {{on 'click' this.saveGroup}}
            >Save New Group</button>
            <button
              class='primary-button cancel-button'
              type='button'
              {{on 'click' this.toggleAddGroup}}
            >Done</button>
          </div>
        {{/if}}
        <ul class='listing {{if this.addGroup "groups"}}'>
          {{#each this.groups as |group|}}
            {{#unless group.isTrashed}}
              <GroupInfo
                @group={{group}}
                @addGroup={{this.addGroup}}
                @students={{this.studentList}}
                @saveGroup={{this.saveGroupChanges}}
                @updateGroup={{this.updateGroup}}
                @deleteGroup={{this.deleteGroup}}
              />
            {{/unless}}
          {{/each}}
        </ul>
      </div>

    </fieldset>
    {{#each this.queryErrors as |error|}}
      <p class='error-message'>{{error}}</p>
    {{/each}}
    {{#each this.updateSectionErrors as |error|}}
      <p class='error-message'>{{error}}</p>
    {{/each}}
    {{#each this.findRecordErrors as |error|}}
      <p class='error-message'>{{error}}</p>
    {{/each}}
  </form>
  {{#unless this.cantEdit}}
    <button
      id='deleteSection'
      class='right'
      type='button'
      {{on 'click' this.confirmDelete}}
    ><i class='fa fa-trash' aria-hidden='true'></i></button>

  {{/unless}}

  {{#each this.problemLoadErrors as |error|}}
    <p class='error-message'>{{error}}</p>
  {{/each}}
  {{#if this.showAssignment}}
    <AssignmentNew
      @cachedProblems={{@cachedProblems}}
      @cancel={{this.hideAssignmentEditor}}
      @fromSectionInfo={{true}}
      @problems={{this.problemList}}
      @selectedSection={{@section}}
      @sections={{this.sectionList}}
    />
  {{/if}}
</div>
{{#if this.showDoneToImport}}
  <div class='section-info-detail import-return'>
    <div class='import-spacer' aria-hidden='true'></div>
    <div class='section-info-import-return'>
      {{#unless this.canReturnToImport}}
        <p class='info'>Add at least one student before returning to import.</p>
      {{/unless}}
      <button
        class='primary-button'
        type='button'
        disabled={{not this.canReturnToImport}}
        {{on 'click' this.doneToImport}}
      >
        Done Adding Students
      </button>
    </div>
  </div>
{{/if}}
