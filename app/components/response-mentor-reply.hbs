<div id="response-mentor-reply">
{{#unless @isOlderRevision}}
  {{#if @isCreating}}
    <ResponseNew
      @isCreating={{@isCreating}}
      @submission={{@submission}}
      @responseData={{this.responseNewModel}}
      @recipient={{@response.recipient}}
      @newReplyStatus={{this.newReplyStatus}}
      @newReplyType='mentor'
      @onSaveSuccess={{this.onSaveSuccess}}
      @canDirectSend={{@canDirectSend}}
      @submissionResponses={{@submissionResponses}}
      @handleResponseThread={{this.handleNewMentorReply}}
    />
  {{/if}}
{{/unless}}

  {{#if this.sortedMentorReplies}}
    {{#unless @isOlderRevision}}
      {{#if @isCreating}}
        <h3 class='previous-responses-header'>Previous Conversation</h3>
      {{/if}}
    {{/unless}}
    {{#each this.sortedMentorReplies as |reply|}}
      {{#if reply.createdBy.username}}
      <div class='response-mentor-container'>
        <div class='response-mentor-info'>
          {{#if @isParentWorkspace}}
                <div class='response-users'>
                  <p>
                    <span class='response-label'>To:</span>
                    <span
                      class='response-value recipient'
                    >{{reply.recipient.username}}
                    </span>
                    {{#if this.showRecipientReadUnread}}
                      <span class='response-read-unread'><i
                          title={{this.recipientReadUnreadIcon.title}}
                          class={{this.recipientReadUnreadIcon.className}}
                        ></i></span>
                    {{/if}}
                  </p>
                  <p>
                    <span class='response-label'>Mentor:</span>
                    <span class='response-value'>
                      {{#if @isParentWorkspace}}
                        {{reply.originalResponse.createdBy.username}}
                      {{else}}
                        {{reply.createdBy.username}}
                      {{/if}}
                    </span>
                  </p>
                  <span class='response-time'>{{format-date
                      reply.originalResponse.createDate
                      'MMMM Do YYYY'
                    }}
                    {{format-date
                      reply.originalResponse.createDate
                      'h:mm a'
                    }}</span>
                </div>
                {{! if not in parent workspace }}
              {{else}}
                <div class='response-users'>
                  <div class='mentor-thread-container'>
                    <div class='mentor-header-thread'>
                      <p>Mentor: {{reply.createdBy.username}} {{#if (this.isDraftReply reply)}}<span style="background: #778899; color: white; padding: 2px 8px; border-radius: 3px; font-size: 0.85em; margin-left: 8px;">DRAFT</span>{{/if}}</p>
                      <p class='response-time'>{{format-date
                          reply.createDate
                          'MMMM Do, YYYY'
                        }}
                        {{format-date
                          reply.createDate
                          'h:mm a'
                        }}</p></div>

                    <p>
                      To:
                      {{reply.recipient.username}}
                      {{#if this.showRecipientReadUnread}}
                        <i
                          title={{this.recipientReadUnreadIcon.title}}
                          class={{this.recipientReadUnreadIcon.className}}
                        ></i>
                      {{/if}}
                    </p>

                    <div class='response-text-container'>
                      <div
                        class='response-text'
                      >
                        {{{reply.text}}}
                      </div>
                    </div>
                  </div>
                  <div class='response-content'>
                    {{!-- {{#if this.showEdit}}
              <i {{action "handleComposeAction" "isEditing" true false}} class="far fa-edit"></i>
            {{/if}} --}}
                    {{#if reply.note}}
                      <div class='response-note-container'>
                        <p class='response-header'>Note for Approver</p>
                        <div class='response-note'>
                          {{reply.note}}
                        </div>
                      </div>
                    {{/if}}
                  </div>
                </div>
          {{/if}}
        </div>
        <div class="mentor-reply-actions button-row">
          {{#if (this.showResumeDraftForReply reply)}}
            <button {{on 'click' (fn this.editDraft reply)}} class="primary-button" type="button">Edit Draft</button>
          {{/if}}
          {{#if (this.canTrashReply reply)}}
            <button {{on 'click' (fn this.confirmTrash reply)}} class="primary-button" type="button">
              <i class="fas fa-trash"></i> Delete
            </button>
          {{/if}}
        </div>
        {{#if (this.isEditingThisDraft reply)}}
          <div class='response-compose edit-draft-compose'>
            <p class='response-header'>Edit Draft</p>
            <Ui::QuillContainer
              @onEditorChange={{this.updateQuillText}}
              @attrSectionId='draft-editor'
              @startingText={{this.editRevisionText}}
              @maxLength={{5000}}
              @showErrors={{true}}
              @emptyErrorMessage='Message body cannot be blank'
            />
            {{#if this.showApproverNoteInput}}
              <div class='approve-note'>
                <p class='response-header'>Note to Approver</p>
                <Textarea
                  class='approver-note'
                  @value={{this.editRevisionNote}}
                />
              </div>
            {{/if}}
            <div class='submit-buttons button-row'>
              <button class='primary-button' type='button' {{on 'click' (fn this.saveResponse false)}}>{{this.saveButtonText}}</button>
              <button class='primary-button' type='button' {{on 'click' (fn this.saveResponse true)}}>Save Draft</button>
              <button class='primary-button' type='button' {{on 'click' this.cancelCompose}}>Cancel</button>
            </div>
          </div>
        {{/if}}

      </div>
      {{/if}}
    {{/each}}


  {{else}}
    {{#unless @isOlderRevision}}
      <p class='info'>No Mentor Feedback for this revision yet.</p>
      <img src='/assets/images/no-message.svg' alt='No Replies' />
      {{#if this.canSendNew}}
        Click 'New Response' to begin composing a new Mentor Reply.
        <div class="submit-buttons button-row">
          <LinkTo
            @route="responses.new.submission"
            @model={{@submission.id}}
            class="primary-button"
          >
            New Response
          </LinkTo>
        </div>
      {{/if}}
    {{/unless}}
  {{/if}}
  {{! page pagination for mentor replies }}
  {{!-- <div class="mentor-replies">
      <BreadCrumbs @items={{sortedMentorReplies}} @onSelect={{action "setDisplayMentorReply"}} @titleTextPath="shortText" @selectedItem={{displayResponse}} @infoToolTipText={{revisionsToolTip}} />
    </div> --}}
</div>